# Copy to .env.test (gitignored) for e2e runs. No secrets belong in this example.

# Ref of your TEST Supabase project — the "<ref>" in https://<ref>.supabase.co.
# E2E refuses to run unless the dev server's NEXT_PUBLIC_SUPABASE_URL matches it.
E2E_SUPABASE_TEST_REF=

# Optional: point e2e at a non-localhost, NON-PRODUCTION preview URL.
# PLAYWRIGHT_BASE_URL=https://my-preview.example.com
# E2E_ALLOW_REMOTE_BASE_URL=1

# Optional: extra hosts the browser may reach during e2e, comma-separated.
# E2E_EXTRA_ALLOWED_HOSTS=
