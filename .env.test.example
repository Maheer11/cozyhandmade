# Copy to .env.test and fill in TEST-MODE-ONLY credentials.
# tests/setup/testEnv.ts refuses to run if NODE_ENV is "production", and
# lib/stripe/env.ts separately refuses any key that isn't sk_test_/pk_test_
# prefixed outside production — so there are two independent guards against
# ever accidentally running the suite against the live Stripe account.

STRIPE_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_test_webhook_secret_here

# A dedicated Supabase project (or branch) for tests — NEVER point this at
# production. Needs the same schema as lib/supabase/schema.sql applied,
# including migration 004_stripe_migration.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-test-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-test-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-test-service-role-key

# --- Playwright e2e (npm run test:e2e) ---
# The e2e browser drives a separately started `npm run dev`, which reads
# .env.local (not this file). tests/e2e/global-setup.ts refuses to run unless
# that server's NEXT_PUBLIC_SUPABASE_URL is https://<this ref>.supabase.co.
# The ref is the "<ref>" in the test project's URL above.
E2E_SUPABASE_TEST_REF=your-test-project

# Optional: point e2e at a non-localhost, NON-PRODUCTION preview URL.
# PLAYWRIGHT_BASE_URL=https://my-preview.example.com
# E2E_ALLOW_REMOTE_BASE_URL=1

# Optional: extra hosts the browser may reach during e2e, comma-separated.
# E2E_EXTRA_ALLOWED_HOSTS=
